rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Development mode: Allow public access for demo
    // WARNING: In production, replace with proper auth checks
    match /floorPlans/{doc} {
      allow read, write: if true;
    }
    match /devices/{doc} {
      allow read, write: if true;
    }
    match /usageLogs/{doc} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
